# MicroStrategy Connection
MSTR_BASE_URL=https://your-mstr-instance.com/MicroStrategyLibrary
MSTR_USERNAME=
MSTR_PASSWORD=
MSTR_PROJECT_ID=

# Tableau Server Connection
TABLEAU_SERVER_URL=https://your-tableau-server.com
TABLEAU_SITE_ID=
TABLEAU_TOKEN_NAME=
TABLEAU_TOKEN_VALUE=

# Warehouse Connection (for Hyper extraction - ADR-022)
WAREHOUSE_TYPE=sqlserver
WAREHOUSE_HOST=
WAREHOUSE_PORT=1433
WAREHOUSE_DATABASE=
WAREHOUSE_USERNAME=
WAREHOUSE_PASSWORD=

# LLM Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_CACHE_DIR=./artifacts/llm_cache

# Application Settings
DATABASE_URL=sqlite:///./artifacts/migrations.db
ARTIFACTS_DIR=./artifacts
TEMPLATE_VERSION=2024.2
LOG_LEVEL=INFO

# Validation Thresholds
NUMERIC_THRESHOLD=0.98
KPI_TOLERANCE=0.001
SECURITY_CONFIDENCE_REQUIRED=1.0
